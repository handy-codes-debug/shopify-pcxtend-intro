<div class="pce-container full-width">
  <footer class="pce-footer">
    <a class="pce-footer__logo" href="{{ routes.root_url }}">
      {% if section.settings.logo %}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy' }}
      {% else %}
        {{ 'pce-logo.jpg' | asset_url | image_tag: alt: shop.name, width: 1024, height: 230, loading: 'lazy' }}
      {% endif %}
    </a>

    <div class="pce-footer__links">
      {% if section.settings.menu.links.size > 0 %}
        {% for link in section.settings.menu.links %}
          {{ link.title | link_to: link.url }}
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}#services">Services</a>
        <a href="{{ routes.root_url }}#approach">Approach</a>
        <a href="{{ routes.root_url }}#about">About</a>
        <a href="{{ routes.root_url }}#contact">Contact</a>
      {% endif %}
    </div>

    {% if section.settings.show_payment_icons %}
      <div class="pce-footer__payment">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    {% endif %}

    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
  </footer>
</div>

{% stylesheet %}
  .pce-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: center;
    justify-content: space-between;
    padding: 32px 0 40px;
    border-top: 2px solid var(--pce-divider);
    font-size: 13px;
    color: color-mix(in srgb, var(--pce-text) 70%, transparent);
  }
  .pce-footer__logo img {
    height: 28px;
    width: auto;
    mix-blend-mode: multiply;
  }
  .pce-footer__links,
  .pce-footer__payment {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
  body .pce-footer__links a {
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to use the bundled PCE Group logo."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "info": "Leave empty to link to the homepage sections."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": false
    }
  ]
}
{% endschema %}
