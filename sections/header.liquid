<header class="pce-header full-width" style="--pce-logo-height: {{ section.settings.logo_height }}px;">
  <a class="pce-header__logo" href="{{ routes.root_url }}">
    {% if section.settings.logo %}
      {{ section.settings.logo | image_url: width: 600 | image_tag: alt: shop.name, loading: 'eager' }}
    {% else %}
      <img src="{{ 'pce-logo.jpg' | asset_url }}" alt="{{ shop.name | escape }}" width="1024" height="230">

    {% endif %}
  </a>

  <nav class="pce-header__menu" aria-label="Main">
    {% if section.settings.menu.links.size > 0 %}
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {% endfor %}
    {% else %}
      <a href="{{ routes.root_url }}#services">Services</a>
      <a href="{{ routes.root_url }}#approach">Approach</a>
      <a href="{{ routes.root_url }}#about">About</a>
    {% endif %}

    {% if section.settings.cta_label != blank %}
      {%- assign contact_url = routes.root_url | append: '#contact' -%}
      <a class="pce-btn pce-btn--primary" href="{{ section.settings.cta_link | default: contact_url }}">
        {{- section.settings.cta_label -}}
      </a>
    {% endif %}

    {% if section.settings.show_store_icons %}
      <div class="pce-header__icons">
        {% if shop.customer_accounts_enabled %}
          <shopify-account menu="{{ section.settings.customer_account_menu }}">
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        {% endif %}

        <a href="{{ routes.cart_url }}">
          {% if cart.item_count > 0 %}
            <sup>{{ cart.item_count }}</sup>
          {% endif %}

          {{ 'icon-cart.svg' | inline_asset_content }}
        </a>
      </div>
    {% endif %}
  </nav>
</header>

{% stylesheet %}
  .shopify-section:has(> .pce-header) {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--pce-bg);
  }
  .pce-header {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 12px var(--pce-gutter);
    border-bottom: 2px solid var(--pce-divider);
  }
  .pce-header__logo {
    display: flex;
    align-items: center;
    margin-right: auto;
  }
  .pce-header__logo img {
    height: var(--pce-logo-height, 36px);
    width: auto;
    mix-blend-mode: multiply;
  }
  .pce-header__menu {
    display: flex;
    gap: 24px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  body .pce-header__menu > a:not(.pce-btn) {
    color: var(--pce-text);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }
  body .pce-header__menu > a:not(.pce-btn):hover,
  body .pce-header__menu > a[aria-current='page'] {
    color: var(--pce-accent);
  }
  .pce-header__icons {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .pce-header__icons a {
    position: relative;
    display: flex;
    color: var(--pce-text);
  }
  .pce-header__icons svg {
    width: 1.5rem;
  }
  .pce-header__icons sup {
    position: absolute;
    left: 100%;
  }
  @media (max-width: 640px) {
    .pce-header {
      flex-wrap: wrap;
      gap: 12px;
    }
    .pce-header__menu {
      gap: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to use the bundled PCE Group logo."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "info": "Leave empty to link to the homepage Services, Approach and About sections."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_store_icons",
      "label": "Show account and cart icons",
      "default": false
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
