<section class="pce-band pce-band--{{ section.settings.style }} full-width">
  <div class="pce-container pce-band__inner">
    <h2 class="pce-band__heading">
      <span>{{ section.settings.heading_line_1 }}</span>
      {% if section.settings.heading_line_2 != blank %}
        <span class="pce-band__second">{{ section.settings.heading_line_2 }}</span>
      {% endif %}
    </h2>
  </div>
</section>

{% stylesheet %}
  .pce-band {
    color: var(--pce-bg);
  }
  .pce-band--green {
    background: var(--pce-accent);
  }
  .pce-band--ink {
    background: var(--pce-text);
  }
  .pce-band--ink .pce-band__second {
    color: var(--pce-accent-300);
  }
  .pce-band__inner {
    padding-block: clamp(56px, 7vw, 96px);
  }
  .pce-band__heading {
    font-family: var(--pce-font);
    font-weight: var(--pce-heading-weight);
    font-size: clamp(34px, 4.4vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 0 -0.05em;
  }
  .pce-band__heading span {
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PCE closing band",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "green",
          "label": "Green"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "green"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Planning a new site, upgrade or build-out?"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "Talk to one team about all of it."
    }
  ],
  "presets": [
    {
      "name": "PCE closing band"
    }
  ]
}
{% endschema %}
